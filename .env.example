# Encryption Keys
ENCRYPTION_KEY=your_encryption_key_here
COOKIE_ENCRYPTION_KEY=your_cookie_encryption_key_here

# Weather & Air Quality APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here
AQI_TOKEN=your_aqi_token_here

# AI APIs
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# ZM API Configuration
ZM_API_BASE_URL=https://example.com/api
ZM_API_KEY=your_zm_api_key_here

# CapCut API Configuration
CAPCUT_API_BASE_URL=https://jonellccapisprojectv2-a62001f39859.herokuapp.com/api/capcut

# TikTok API Configuration
TIKTOK_API_BASE_URL=https://www.tikwm.com/api/

# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here

# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_SERVER_ID=your_discord_server_id_here
DISCORD_PREFIX=.

# Clash of Clans API Configuration
COC_API_TOKEN=your_coc_api_token_here
COC_API_BASE_URL=https://api.clashofclans.com/v1

# Imgur API Configuration
IMGUR_CLIENT_ID=your_imgur_client_id_here

# Database
MONGO_URI=your_mongodb_connection_uri_here

# Appstate Sync (đồng bộ appstate từ URL - JSONBin, raw JSON...)
# APPSTATE_SYNC_ENABLED: bật/tắt toàn bộ (kiểm tra trước login + đồng bộ sau login). Giá trị: true|false|0|off|no (mặc định: true)
APPSTATE_SYNC_ENABLED=true
APPSTATE_SYNC_URL=
APPSTATE_SYNC_API_KEY=
# Chu kỳ kiểm tra (phút). Chỉ áp dụng khi APPSTATE_SYNC_ENABLE_PERIODIC=true
APPSTATE_SYNC_INTERVAL=15
# APPSTATE_SYNC_ENABLE_PERIODIC: false = chỉ kiểm tra 1 lần sau khi login, không chạy định kỳ
APPSTATE_SYNC_ENABLE_PERIODIC=true

